# Postgres connection string (Supabase: use the transaction pooler, port 6543)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres
# 32+ random chars: python -c "import secrets;print(secrets.token_urlsafe(32))"
SESSION_SECRET=change-me-to-something-long-and-random
# true in production (HTTPS), false locally
COOKIE_SECURE=false
